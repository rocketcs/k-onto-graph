    {
      "id": "a8e50dca-04a0-53ef-8190-d6924087b119",
      "familyId": "a8e50dca-04a0-53ef-8190-d6924087b119",
      "source_id": "循上医疗",
      "target_id": "长寿医学",
      "type": "重点发展",
      "weight": 1.0,
      "properties": {
        "evidence": "长寿医学Longevity Medicine\n\nForever Fit 120 Years Young\n\n长寿医学助力健康活力120岁\n\n作为对基本医疗保障的重要补充，循上医疗更专注于78.3岁（平均寿命）至120岁人群的健康需求。通过前沿的综合抗衰老疗法、慢病系统管理等方式，延长健康寿命、助力实现“健康活力120岁”的核心目标。",
        "status": "文档陈述",
        "chunk": 1,
        "source_document": "循上介介绍-无股东版.docx",
        "quantity_text": null,
        "year_text": null,
        "evidence_paragraph_ids": [
          19,
          22
        ],
        "template_version": "1.1.0",
        "rules_version": "1.1.0"
      }
    },
    {
      "id": "b7d62273-9574-5ab0-b716-35e3d051d27b",
      "familyId": "b7d62273-9574-5ab0-b716-35e3d051d27b",
      "source_id": "循上医疗",
      "target_id": "慢病逆转",
      "type": "重点发展",
      "weight": 1.0,
      "properties": {
        "evidence": "慢病逆转Precision Medicine\n\nTo Reveal The Root of Every Cause\n\n致力为所有医疗病症寻找源头\n\n慢病逆转不仅仅是延缓病程，更是基于前沿医学实现疾病状态真正改善的系统工程。慢病的发生总有原因，同一种症状可能根源于不同器官或系统的功能失衡。现阶段很多慢病找不到妥善的解决方案，很重要的原因是没有好的工具，循上医疗专注于通过精准医学、功能医学等国际前沿的医疗诊断方式，“循源而上、抽丝剥茧、釜底抽薪”，致力于为所有医疗病症寻找源头。",
        "status": "文档陈述",
        "chunk": 1,
        "source_document": "循上介介绍-无股东版.docx",
        "quantity_text": null,
        "year_text": null,
        "evidence_paragraph_ids": [
          23,
          26
        ],
        "template_version": "1.1.0",
        "rules_version": "1.1.0"
      }
    },
    {
      "id": "4dfd5f11-6326-584e-8eee-d1aaabb3c9b7",
      "familyId": "4dfd5f11-6326-584e-8eee-d1aaabb3c9b7",
      "source_id": "循上医疗",
      "target_id": "肿瘤癌症",
      "type": "重点发展",
      "weight": 1.0,
      "properties": {
        "evidence": "肿瘤癌症Innovative Oncology\n\nA Better Future，Without Cancer\n\n创造一个无惧癌症的未来世界\n\n在寿命可延至120岁的新医学时代，许多在78.3岁平均寿命下的良性结节将有更高概率演变为癌症。循上医疗肿瘤癌症学科聚焦癌症极早期，对潜在高风险病灶实施前置化干预。对已确诊患者，整合全球先端医疗资源与多学科诊疗模式，涵盖微创精准手术、靶向与免疫疗法、细胞基因治疗及疼痛管理，力求在保全生命质量的同时，延长、更安全且更有尊严地管理生存周期。",
        "status": "文档陈述",
        "chunk": 1,
        "source_document": "循上介介绍-无股东版.docx",
        "quantity_text": null,
        "year_text": null,
        "evidence_paragraph_ids": [
          27,
          30
        ],
        "template_version": "1.1.0",
        "rules_version": "1.1.0"
      }
    },
    {
      "id": "70b2cedf-f8e8-5421-b403-60a49f62132d",
      "familyId": "70b2cedf-f8e8-5421-b403-60a49f62132d",
      "source_id": "循上医疗",
      "target_id": "疑难重症",
      "type": "重点发展",
      "weight": 1.0,
      "properties": {
        "evidence": "疑难重症 Complex Diseases\n\nWhere Disciplines Converge, Miracles Emerge\n\n多学科联合诊疗破解疑难困局\n\n面向诊断困难、病程复杂、反复无效治疗的患者人群，循上医疗集结跨学科专家，联动全球医学资源，突破常规路径，致力于为「被放弃」「被误解」「未被确诊」的患者寻找解决方案。",
        "status": "文档陈述",
